# Leave empty to disable / not implemented in this stage.
DATABASE_DSN=postgresql://plaything:plaything@localhost:5432/plaything
DISCORD_TOKEN=your_discord_bot_token_here

# NEIS meal API base URL (mealServiceDietInfo). The bot appends `&MLSV_YMD=<date>`.
# Example:
#   MEAL_URL=https://open.neis.go.kr/hub/mealServiceDietInfo?Type=json&pIndex=1&pSize=100&ATPT_OFCDC_SC_CODE=J10&SD_SCHUL_CODE=7652056
MEAL_URL=

# Discord channel id used for the daily meal output.
# 0 falls back to LOG_CHANNEL_ID, and 0 for both disables output (logs only).
MEAL_CHANNEL_ID=0

# Primary timezone for scheduler cron triggers and log timestamps.
TIMEZONE=Asia/Seoul

# Parent directory that holds Minecraft server folders (real host path).
MC_PARENT_DIRECTORY=

# Minecraft port range (auto-assigned & validated). Must match docker-compose publish range.
MC_PORT_START=25565
MC_PORT_END=25620

# Public IP/hostname players use to connect (shown by !마크 주소).
MC_PUBLIC_HOST=

# Internal (same router) LAN IP shown by `!마크 주소 <맵> 내부`.
# Docker에서는 자동 감지가 컨테이너 IP를 반환하므로 호스트 LAN IP를 설정하세요.
MC_INTERNAL_HOST=192.168.0.10

# Java executable used to run servers, server flavor (paper|vanilla), and version to bootstrap.
MC_JAVA_COMMAND=java
MC_SERVER_FLAVOR=paper
MC_SERVER_VERSION=26.2
MC_MAX_MEMORY=1G

# RCON connection defaults (host/port base + password derivation secret).
MC_RCON_HOST=127.0.0.1
MC_RCON_PORT=25575
MC_RCON_PASSWORD_SECRET=change-me

# Player monitoring cadence and idle auto-shutdown window (seconds).
MC_MONITOR_INTERVAL_SECONDS=30
MC_IDLE_SHUTDOWN_SECONDS=300

# Minecraft world backup settings.
# Backups are stored as <MC_BACKUP_DIRECTORY>/<server>/<server>-YYYYMMDD-HHmmss.backup.zip
# and archives older than MC_BACKUP_RETENTION_DAYS are pruned (the newest per
# server is always kept). Use an absolute host path in Docker so backups persist.
MC_BACKUP_DIRECTORY=./backups
MC_BACKUP_RETENTION_DAYS=90

# Daily automatic backup time (24h). The job backs up every registered server
# and prunes expired backups per MC_BACKUP_RETENTION_DAYS.
MC_BACKUP_HOUR=4
MC_BACKUP_MINUTE=0

# Discord channel id used for log forwarding. REQUIRED — the bot refuses to
# start without it (operational logging must be enabled).
LOG_CHANNEL_ID=0