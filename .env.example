# Leave empty to disable / not implemented in this stage.
DATABASE_DSN=postgresql://plaything:plaything@localhost:5432/plaything
DISCORD_TOKEN=your_discord_bot_token_here

# Meal API endpoint (unused in this foundation stage).
MEAL_URL=

# Parent directory that holds Minecraft server folders.
MC_PARENT_DIRECTORY=

# Java executable used to run servers, and vanilla version to bootstrap.
MC_JAVA_COMMAND=java
MC_SERVER_VERSION=1.21.4
MC_MAX_MEMORY=1G

# RCON connection defaults (host/port base + password derivation secret).
MC_RCON_HOST=127.0.0.1
MC_RCON_PORT=25575
MC_RCON_PASSWORD_SECRET=change-me

# Player monitoring cadence and idle auto-shutdown window (seconds).
MC_MONITOR_INTERVAL_SECONDS=30
MC_IDLE_SHUTDOWN_SECONDS=300

# Discord channel id used for log forwarding (0 disables).
LOG_CHANNEL_ID=0